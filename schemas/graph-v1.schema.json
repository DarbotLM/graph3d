{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graph3d.dev/schemas/graph-v1.schema.json",
  "title": "graph3d graph node-link",
  "type": "object",
  "required": ["schema_version", "nodes", "links"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "directed": { "type": ["boolean", "null"] },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
